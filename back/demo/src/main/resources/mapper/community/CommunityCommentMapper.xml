<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.community.CommunityCommentDAO">
  <resultMap id="communityCommentResultMap" type="com.example.demo.community.CommunityCommentDTO">
    <id property="id" column="id" />
    <result property="postId" column="post_id" />
    <result property="userId" column="user_id" />
    <result property="authorName" column="author_name" />
    <result property="content" column="content" />
    <result property="createdAt" column="created_at" />
  </resultMap>

  <select id="selectCommentsByPostId" resultMap="communityCommentResultMap">
    SELECT
      c.id,
      c.post_id,
      c.user_id,
      u.name AS author_name,
      c.content,
      c.created_at
    FROM comments c
    INNER JOIN users u ON c.user_id = u.id
    WHERE c.post_id = #{postId}
    ORDER BY c.created_at ASC
  </select>

  <select id="selectCommentById" resultMap="communityCommentResultMap">
    SELECT
      c.id,
      c.post_id,
      c.user_id,
      u.name AS author_name,
      c.content,
      c.created_at
    FROM comments c
    INNER JOIN users u ON c.user_id = u.id
    WHERE c.id = #{commentId}
  </select>

  <insert id="insertComment" parameterType="com.example.demo.community.CommunityCommentDTO" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO comments (
      post_id,
      user_id,
      content
    )
    VALUES (
      #{postId},
      #{userId},
      #{content}
    )
  </insert>

  <update id="updateComment" parameterType="com.example.demo.community.CommunityCommentDTO">
    UPDATE comments
    SET content = #{content}
    WHERE id = #{id}
  </update>

  <delete id="deleteComment">
    DELETE FROM comments
    WHERE id = #{commentId}
  </delete>

  <delete id="deleteCommentsByPostId">
    DELETE FROM comments
    WHERE post_id = #{postId}
  </delete>
</mapper>
